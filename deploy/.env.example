# The viewing key the ledger reads positions with. It reads every deposit and
# can spend none of them, which is the most this box should ever hold.
#
# The spending key is NOT here and must never be. Withdrawals are paid by
# running `ring-wallet pay` somewhere else, from the seed phrase, by hand.
RING_UFVK=uview1...

# The block the wallet was made at. Scanning starts here; a height before the
# wallet existed only costs time, a height after it loses deposits.
RING_BIRTHDAY=0

# Empty for mainnet. Set to --testnet to run against coins worth nothing,
# which is how this is proved before it is trusted with anything.
RING_NETWORK=
